// aero-serde-toml
// TOML-focused serialization helpers for pure-Aero programs (self-contained).
// Works on the flat subset: `key = value` assignments, `[table]` headers and
// `#` comments.

fn st_trim(s: str) -> str {
    let src = String::from(s);
    let n = src.len();
    let mut b = 0;
    while ((b < n) && (src.at(b) <= 32)) {
        b = b + 1;
    }
    let mut e = n;
    while ((e > b) && (src.at(e - 1) <= 32)) {
        e = e - 1;
    }
    if (b >= e) {
        return "";
    }
    return substr(s, b, e);
}

// Strip a trailing `#` comment (not inside quotes).
fn st_strip_comment(line: str) -> str {
    let src = String::from(line);
    let n = src.len();
    let mut in_q = 0;
    let mut hash = -1;
    let mut i = 0;
    while (i < n) {
        let c = src.at(i);
        if (c == 34) {
            in_q = 1 - in_q;
        } else if ((c == 35) && (in_q == 0)) {
            hash = i;
            break;
        }
        i = i + 1;
    }
    if (hash < 0) {
        return st_trim(line);
    }
    return st_trim(substr(line, 0, hash));
}

// Split `key = value` at the first '=' (ignoring '=' inside quoted strings).
fn st_split(line: str) -> str {
    let src = String::from(line);
    let n = src.len();
    let mut i = 0;
    while (i < n) {
        let c = src.at(i);
        if (c == 34) {
            let mut j = i + 1;
            while ((j < n) && (src.at(j) != 34)) {
                j = j + 1;
            }
            i = j + 1;
            continue;
        }
        if (c == 61) {
            return substr(line, 0, i) + format("%c", 31) + substr(line, i + 1, n);
        }
        i = i + 1;
    }
    return "";
}

fn st_key(pair: str) -> str {
    let sep = str_find(pair, format("%c", 31));
    if (sep < 0) {
        return "";
    }
    return st_trim(substr(pair, 0, sep));
}

fn st_val(pair: str) -> str {
    let sep = str_find(pair, format("%c", 31));
    if (sep < 0) {
        return "";
    }
    let v = st_trim(substr(pair, sep + 1, len(pair)));
    let s = String::from(v);
    let n = s.len();
    if ((n >= 2) && (s.at(0) == 34) && (s.at(n - 1) == 34)) {
        return substr(v, 1, n - 1);
    }
    return v;
}

// Encode a string assignment: `key = "val"`.
fn serde_toml_encode(key: str, val: str) -> str {
    return key + " = \"" + val + "\"";
}

fn serde_toml_encode_int(key: str, val: i64) -> str {
    return key + " = " + format("%lld", val);
}

fn serde_toml_encode_bool(key: str, val: bool) -> str {
    if (val) {
        return key + " = true";
    }
    return key + " = false";
}

// Look up a key in a flat TOML document (leaf keys match regardless of table).
fn serde_toml_get(doc: str, key: str) -> str {
    let n = len(doc);
    let mut start = 0;
    let mut i = 0;
    while (i <= n) {
        if ((i == n) || (String::from(doc).at(i) == 10)) {
            let line = substr(doc, start, i);
            let clean = st_strip_comment(line);
            if (len(clean) > 0) {
                let pair = st_split(clean);
                if (len(pair) > 0) {
                    if (str_cmp(st_key(pair), key) == 0) {
                        return st_val(pair);
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn serde_toml_get_int(doc: str, key: str) -> i64 {
    return str_to_int(serde_toml_get(doc, key));
}

fn serde_toml_get_bool(doc: str, key: str) -> bool {
    return str_cmp(serde_toml_get(doc, key), "true") == 0;
}

fn test_serde_toml_basic() -> bool {
    if (str_cmp(serde_toml_encode("name", "aero"), "name = \"aero\"") != 0) {
        return false;
    }
    if (str_cmp(serde_toml_encode_int("port", 8080), "port = 8080") != 0) {
        return false;
    }
    if (str_cmp(serde_toml_get("title = \"Hi\"\n[server]\nport = 8080\n", "port"), "8080") != 0) {
        return false;
    }
    if (str_cmp(serde_toml_get("name = \"Aero\" # note", "name"), "Aero") != 0) {
        return false;
    }
    if (serde_toml_get_int("n = 7", "n") != 7) {
        return false;
    }
    return true;
}
