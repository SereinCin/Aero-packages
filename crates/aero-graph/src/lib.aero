// aero-graph
// A directed graph with adjacency lists for pure-Aero programs
// (self-contained). Uses a forward-star layout (head/to/nxt arrays).
// Provides edge/degree queries, BFS shortest path and Kahn topological sort.

struct Graph {
    head: Vec<i64>,   // first edge index per node, or -1
    to: Vec<i64>,
    nxt: Vec<i64>,
    n: i64,
}

fn graph_new(n: i64) -> Graph {
    let mut g = Graph { head: Vec::new(), to: Vec::new(), nxt: Vec::new(), n: n };
    let mut i = 0;
    while (i < n) {
        g.head.push(-1);
        i = i + 1;
    }
    return g;
}

fn graph_nodes(g: &Graph) -> i64 {
    return g.n;
}

fn graph_edge_count(g: &Graph) -> i64 {
    return g.to.len();
}

fn graph_add_edge(g: &mut Graph, u: i64, v: i64) {
    g.to.push(v);
    g.nxt.push(g.head.get(u));
    g.head.set(u, g.to.len() - 1);
}

fn graph_has_edge(g: &Graph, u: i64, v: i64) -> bool {
    let mut e = g.head.get(u);
    while (e >= 0) {
        if (g.to.get(e) == v) {
            return true;
        }
        e = g.nxt.get(e);
    }
    return false;
}

fn graph_degree(g: &Graph, u: i64) -> i64 {
    let mut c = 0;
    let mut e = g.head.get(u);
    while (e >= 0) {
        c = c + 1;
        e = g.nxt.get(e);
    }
    return c;
}

fn graph_neighbors(g: &Graph, u: i64) -> str {
    let mut out = "";
    let mut e = g.head.get(u);
    while (e >= 0) {
        if (len(out) > 0) {
            out = out + ",";
        }
        out = out + format("%lld", g.to.get(e));
        e = g.nxt.get(e);
    }
    return out;
}

// Unweighted BFS distance from s to t (-1 when unreachable).
fn graph_bfs(g: &Graph, s: i64, t: i64) -> i64 {
    let mut dist: Vec<i64> = Vec::new();
    let mut i = 0;
    while (i < g.n) {
        dist.push(-1);
        i = i + 1;
    }
    let mut q: Vec<i64> = Vec::new();
    q.push(s);
    dist.set(s, 0);
    let mut qi = 0;
    while (qi < q.len()) {
        let u = q.get(qi);
        if (u == t) {
            return dist.get(u);
        }
        let mut e = g.head.get(u);
        while (e >= 0) {
            let v = g.to.get(e);
            if (dist.get(v) < 0) {
                dist.set(v, dist.get(u) + 1);
                q.push(v);
            }
            e = g.nxt.get(e);
        }
        qi = qi + 1;
    }
    return -1;
}

// Kahn topological sort; returns comma-separated order, or "" when there is a
// cycle.
fn graph_toposort(g: &Graph) -> str {
    let mut indeg: Vec<i64> = Vec::new();
    let mut i = 0;
    while (i < g.n) {
        indeg.push(0);
        i = i + 1;
    }
    i = 0;
    while (i < g.n) {
        let mut e = g.head.get(i);
        while (e >= 0) {
            let v = g.to.get(e);
            indeg.set(v, indeg.get(v) + 1);
            e = g.nxt.get(e);
        }
        i = i + 1;
    }
    let mut q: Vec<i64> = Vec::new();
    i = 0;
    while (i < g.n) {
        if (indeg.get(i) == 0) {
            q.push(i);
        }
        i = i + 1;
    }
    let mut out = "";
    let mut cnt = 0;
    let mut qi = 0;
    while (qi < q.len()) {
        let u = q.get(qi);
        if (len(out) > 0) {
            out = out + ",";
        }
        out = out + format("%lld", u);
        cnt = cnt + 1;
        let mut e = g.head.get(u);
        while (e >= 0) {
            let v = g.to.get(e);
            indeg.set(v, indeg.get(v) - 1);
            if (indeg.get(v) == 0) {
                q.push(v);
            }
            e = g.nxt.get(e);
        }
        qi = qi + 1;
    }
    if (cnt != g.n) {
        return "";
    }
    return out;
}

fn test_graph_basic() -> bool {
    let mut g = graph_new(4);
    graph_add_edge(&mut g, 0, 1);
    graph_add_edge(&mut g, 0, 2);
    graph_add_edge(&mut g, 1, 3);
    graph_add_edge(&mut g, 2, 3);
    if (graph_edge_count(&g) != 4) {
        return false;
    }
    if (graph_has_edge(&g, 0, 1)) {
    } else {
        return false;
    }
    if (graph_has_edge(&g, 1, 0)) {
        return false;
    }
    if (graph_degree(&g, 0) != 2) {
        return false;
    }
    if (graph_bfs(&g, 0, 3) != 2) {
        return false;
    }
    if (graph_bfs(&g, 0, 1) != 1) {
        return false;
    }
    if (graph_bfs(&g, 3, 0) != -1) {
        return false;
    }
    if (str_cmp(graph_neighbors(&g, 0), "2,1") != 0) {
        return false;
    }
    // acyclic -> toposort has 4 nodes
    let topo = graph_toposort(&g);
    if (len(topo) == 0) {
        return false;
    }
    // cycle -> empty
    let mut gc = graph_new(2);
    graph_add_edge(&mut gc, 0, 1);
    graph_add_edge(&mut gc, 1, 0);
    if (len(graph_toposort(&gc)) != 0) {
        return false;
    }
    return true;
}
