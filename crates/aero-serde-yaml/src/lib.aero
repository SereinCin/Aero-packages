// aero-serde-yaml
// YAML-focused serialization helpers for pure-Aero programs (self-contained).
// Works on the common flat subset: `key: value` mappings with optional `#`
// comments, sequence entries `- item`, and double-quoted string values.

fn sy_trim(s: str) -> str {
    let src = String::from(s);
    let n = src.len();
    let mut b = 0;
    while ((b < n) && (src.at(b) <= 32)) {
        b = b + 1;
    }
    let mut e = n;
    while ((e > b) && (src.at(e - 1) <= 32)) {
        e = e - 1;
    }
    if (b >= e) {
        return "";
    }
    return substr(s, b, e);
}

// Strip a trailing `#` comment (not inside quotes).
fn sy_strip_comment(line: str) -> str {
    let src = String::from(line);
    let n = src.len();
    let mut in_q = 0;
    let mut hash = -1;
    let mut i = 0;
    while (i < n) {
        let c = src.at(i);
        if (c == 34) {
            in_q = 1 - in_q;
        } else if ((c == 35) && (in_q == 0)) {
            hash = i;
            break;
        }
        i = i + 1;
    }
    if (hash < 0) {
        return sy_trim(line);
    }
    return sy_trim(substr(line, 0, hash));
}

// Split `key: value` at the first top-level ':'.
fn sy_split(line: str) -> str {
    let src = String::from(line);
    let n = src.len();
    let mut i = 0;
    while (i < n) {
        let c = src.at(i);
        if (c == 34) {
            let mut j = i + 1;
            while ((j < n) && (src.at(j) != 34)) {
                j = j + 1;
            }
            i = j + 1;
            continue;
        }
        if (c == 58) {
            return substr(line, 0, i) + format("%c", 31) + substr(line, i + 1, n);
        }
        i = i + 1;
    }
    return "";
}

fn sy_key(pair: str) -> str {
    let sep = str_find(pair, format("%c", 31));
    if (sep < 0) {
        return "";
    }
    return sy_trim(substr(pair, 0, sep));
}

fn sy_val(pair: str) -> str {
    let sep = str_find(pair, format("%c", 31));
    if (sep < 0) {
        return "";
    }
    let v = sy_trim(substr(pair, sep + 1, len(pair)));
    // unquote if it is a double-quoted string
    let s = String::from(v);
    let n = s.len();
    if ((n >= 2) && (s.at(0) == 34) && (s.at(n - 1) == 34)) {
        return substr(v, 1, n - 1);
    }
    return v;
}

// Encode a scalar mapping: `key: value`.
fn serde_yaml_encode(key: str, val: str) -> str {
    return key + ": " + val;
}

fn serde_yaml_encode_int(key: str, val: i64) -> str {
    return key + ": " + format("%lld", val);
}

// Look up a key in a flat YAML document.
fn serde_yaml_get(doc: str, key: str) -> str {
    let n = len(doc);
    let mut start = 0;
    let mut i = 0;
    while (i <= n) {
        if ((i == n) || (String::from(doc).at(i) == 10)) {
            let line = substr(doc, start, i);
            let clean = sy_strip_comment(line);
            if (len(clean) > 0) {
                let pair = sy_split(clean);
                if (len(pair) > 0) {
                    if (str_cmp(sy_key(pair), key) == 0) {
                        return sy_val(pair);
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn serde_yaml_get_int(doc: str, key: str) -> i64 {
    return str_to_int(serde_yaml_get(doc, key));
}

fn serde_yaml_get_bool(doc: str, key: str) -> bool {
    return str_cmp(serde_yaml_get(doc, key), "true") == 0;
}

// Encode a list of items as YAML sequence lines: `- item`.
fn serde_yaml_sequence(items: Vec<String>) -> str {
    let mut out = "";
    let mut i = 0;
    while (i < items.len()) {
        let s = items.get(i);
        let mut line = "- ";
        let mut j = 0;
        while (j < s.len()) {
            line = line + format("%c", s.at(j));
            j = j + 1;
        }
        if (i > 0) {
            out = out + "\n";
        }
        out = out + line;
        i = i + 1;
    }
    return out;
}

fn test_serde_yaml_basic() -> bool {
    if (str_cmp(serde_yaml_encode("name", "aero"), "name: aero") != 0) {
        return false;
    }
    if (str_cmp(serde_yaml_encode_int("port", 8080), "port: 8080") != 0) {
        return false;
    }
    if (str_cmp(serde_yaml_get("name: aero\nport: 8080\n", "port"), "8080") != 0) {
        return false;
    }
    if (str_cmp(serde_yaml_get("title: \"Hello World\"", "title"), "Hello World") != 0) {
        return false;
    }
    if (serde_yaml_get_int("x: 42 # comment", "x") != 42) {
        return false;
    }
    return true;
}
