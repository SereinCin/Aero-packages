// aero-regex
// Practical regex subset for pure-Aero programs, implemented with a
// recursive-descent parser + greedy backtracking matcher.
//
// Supported syntax:
//   - literal characters
//   - `.`              any character
//   - `[abc]` `[^abc]` character classes, incl. ranges like `[a-z0-9]`
//   - `\d \D \w \W \s \S` predefined classes and escaped literals (`\.` etc.)
//   - quantifiers `*` `+` `?` (greedy, with backtracking)
//   - groups `(...)` and alternation `a|b`
//   - anchors `^` (start) and `$` (end)
//
// Entry points:
//   regex_full_match(pat, text)  -> whole-string match (implicit ^...$)
//   regex_match(pat, text)       -> true if text contains a match anywhere
//
// The matcher is written in an iterative/recursive style compatible with the
// Aero compiler (no tuples: two-field structs are used for match results).

struct MatchRes {
    ok: i64,
    pos: i64,
}

// --- character predicates ---------------------------------------------------

fn is_digit(c: i64) -> i64 {
    if ((c >= 48) && (c <= 57)) {
        return 1;
    }
    return 0;
}

fn is_alpha(c: i64) -> i64 {
    if ((c >= 97) && (c <= 122)) {
        return 1;
    }
    if ((c >= 65) && (c <= 90)) {
        return 1;
    }
    return 0;
}

// \w: letters, digits and underscore.
fn is_word(c: i64) -> i64 {
    if (is_digit(c) == 1) {
        return 1;
    }
    if (is_alpha(c) == 1) {
        return 1;
    }
    if (c == 95) {
        return 1;
    }
    return 0;
}

// \s: space, tab, LF, CR.
fn is_space(c: i64) -> i64 {
    if ((c == 32) || (c == 9) || (c == 10) || (c == 13)) {
        return 1;
    }
    return 0;
}

// --- escape and class matching ---------------------------------------------

// Does the escaped char `e` match text char `tc`?
fn esc_match(e: i64, tc: i64) -> i64 {
    if (e == 100) {
        return is_digit(tc);        // \d
    }
    if (e == 68) {
        return 1 - is_digit(tc);    // \D
    }
    if (e == 119) {
        return is_word(tc);         // \w
    }
    if (e == 87) {
        return 1 - is_word(tc);     // \W
    }
    if (e == 115) {
        return is_space(tc);        // \s
    }
    if (e == 83) {
        return 1 - is_space(tc);    // \S
    }
    if (tc == e) {
        return 1;                   // escaped literal like \. \* \(
    }
    return 0;
}

// Is `tc` inside the `[ ... ]` class starting at `ppos`? Returns 0/1.
fn class_match(pat: str, ppos: i64, tc: i64) -> i64 {
    let s = String::from(pat);
    let n = s.len();
    let mut i = ppos + 1;
    let mut neg = 0;
    if ((i < n) && (s.at(i) == 94)) {
        neg = 1;
        i = i + 1;
    }
    let mut hit = 0;
    while (i < n) {
        let c = s.at(i);
        if (c == 93) {
            break;
        }
        if (c == 92) {
            let e = s.at(i + 1);
            let mut sub = 0;
            if (e == 100) {
                sub = is_digit(tc);
            }
            if (e == 68) {
                sub = 1 - is_digit(tc);
            }
            if (e == 119) {
                sub = is_word(tc);
            }
            if (e == 87) {
                sub = 1 - is_word(tc);
            }
            if (e == 115) {
                sub = is_space(tc);
            }
            if (e == 83) {
                sub = 1 - is_space(tc);
            }
            if (sub == 1) {
                hit = 1;
            }
            if ((sub == 0) && (tc == e)) {
                hit = 1;
            }
            i = i + 2;
        } else if (((i + 2) < n) && (s.at(i + 1) == 45) && (s.at(i + 2) != 93)) {
            // range like a-z
            if ((tc >= c) && (tc <= s.at(i + 2))) {
                hit = 1;
            }
            i = i + 3;
        } else {
            if (tc == c) {
                hit = 1;
            }
            i = i + 1;
        }
    }
    if (neg == 1) {
        return 1 - hit;
    }
    return hit;
}

// --- structural helpers -----------------------------------------------------

// Find the ')' matching the '(' at `ppos`; returns its index or -1.
fn find_paren(pat: str, ppos: i64) -> i64 {
    let s = String::from(pat);
    let n = s.len();
    let mut depth = 1;
    let mut i = ppos + 1;
    while (i < n) {
        let c = s.at(i);
        if (c == 92) {
            i = i + 2;
        } else if (c == 91) {
            let mut j = i + 1;
            while ((j < n) && (s.at(j) != 93)) {
                j = j + 1;
            }
            i = j + 1;
        } else if (c == 40) {
            depth = depth + 1;
            i = i + 1;
        } else if (c == 41) {
            depth = depth - 1;
            if (depth == 0) {
                return i;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return -1;
}

// Find the first top-level `|` inside [ppos, pend); -1 if none.
// Top-level means not inside a group or a character class.
fn find_top_bar(pat: str, ppos: i64, pend: i64) -> i64 {
    let s = String::from(pat);
    let mut depth = 0;
    let mut i = ppos;
    while (i < pend) {
        let c = s.at(i);
        if (c == 92) {
            i = i + 2;
        } else if (c == 91) {
            let mut j = i + 1;
            while ((j < pend) && (s.at(j) != 93)) {
                j = j + 1;
            }
            i = j + 1;
        } else if (c == 40) {
            depth = depth + 1;
            i = i + 1;
        } else if (c == 41) {
            depth = depth - 1;
            i = i + 1;
        } else if (c == 124) {
            if (depth == 0) {
                return i;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return -1;
}

// End index (exclusive) of the atom starting at `ppos` (before any quantifier).
fn atom_end(pat: str, ppos: i64) -> i64 {
    let s = String::from(pat);
    let n = s.len();
    let c = s.at(ppos);
    if (c == 92) {
        return ppos + 2;
    }
    if (c == 91) {
        let mut j = ppos + 1;
        while ((j < n) && (s.at(j) != 93)) {
            j = j + 1;
        }
        return j + 1;
    }
    if (c == 40) {
        let g = find_paren(pat, ppos);
        if (g < 0) {
            return ppos + 1;
        }
        return g + 1;
    }
    return ppos + 1;
}

// --- matching ---------------------------------------------------------------

// Try to match one atom (no quantifier) at pattern[ppos] against text[tpos].
fn m_atom(pat: str, ppos: i64, txt: str, tpos: i64, tlen: i64) -> MatchRes {
    let s = String::from(pat);
    let n = s.len();
    if (ppos >= n) {
        return MatchRes { ok: 0, pos: tpos };
    }
    let c = s.at(ppos);
    if (c == 46) {
        if (tpos < tlen) {
            return MatchRes { ok: 1, pos: tpos + 1 };
        }
        return MatchRes { ok: 0, pos: tpos };
    }
    if (c == 92) {
        let e = s.at(ppos + 1);
        if (tpos >= tlen) {
            return MatchRes { ok: 0, pos: tpos };
        }
        let tc = String::from(txt).at(tpos);
        if (esc_match(e, tc) == 1) {
            return MatchRes { ok: 1, pos: tpos + 1 };
        }
        return MatchRes { ok: 0, pos: tpos };
    }
    if (c == 91) {
        if (tpos >= tlen) {
            return MatchRes { ok: 0, pos: tpos };
        }
        let tc = String::from(txt).at(tpos);
        if (class_match(pat, ppos, tc) == 1) {
            return MatchRes { ok: 1, pos: tpos + 1 };
        }
        return MatchRes { ok: 0, pos: tpos };
    }
    if (c == 40) {
        let gend = find_paren(pat, ppos);
        if (gend < 0) {
            return MatchRes { ok: 0, pos: tpos };
        }
        return m_alt(pat, ppos + 1, gend, txt, tpos, tlen);
    }
    if (tpos < tlen) {
        let tc = String::from(txt).at(tpos);
        if (tc == c) {
            return MatchRes { ok: 1, pos: tpos + 1 };
        }
    }
    return MatchRes { ok: 0, pos: tpos };
}

// Match a run of atoms from pattern[ppos] to pend.
fn m_seq(pat: str, ppos: i64, pend: i64, txt: str, tpos: i64, tlen: i64) -> MatchRes {
    let s = String::from(pat);
    let mut p = ppos;
    let mut t = tpos;
    while (p < pend) {
        let c = s.at(p);
        if (c == 41) {
            break;   // end of a group
        }
        if (c == 36) {
            // '$' anchor at the very end of the sequence
            let mut is_end = 0;
            if ((p + 1) >= pend) {
                is_end = 1;
            }
            if (((p + 1) < pend) && (s.at(p + 1) == 41)) {
                is_end = 1;
            }
            if (is_end == 1) {
                if (t == tlen) {
                    p = p + 1;
                    continue;
                }
                return MatchRes { ok: 0, pos: t };
            }
        }
        let aend = atom_end(pat, p);
        let mut q = 0;
        if (aend < pend) {
            let qc = s.at(aend);
            if (qc == 42) {
                q = 1;      // *
            }
            if (qc == 43) {
                q = 2;      // +
            }
            if (qc == 63) {
                q = 3;      // ?
            }
        }
        if (q == 1) {
            return m_star(pat, p, aend + 1, pend, txt, t, tlen);
        }
        if (q == 2) {
            return m_plus(pat, p, aend + 1, pend, txt, t, tlen);
        }
        if (q == 3) {
            let r1 = m_atom(pat, p, txt, t, tlen);
            if (r1.ok == 1) {
                let r2 = m_seq(pat, aend + 1, pend, txt, r1.pos, tlen);
                if (r2.ok == 1) {
                    return r2;
                }
            }
            return m_seq(pat, aend + 1, pend, txt, t, tlen);
        }
        let r = m_atom(pat, p, txt, t, tlen);
        if (r.ok == 0) {
            return MatchRes { ok: 0, pos: t };
        }
        t = r.pos;
        p = aend;
    }
    return MatchRes { ok: 1, pos: t };
}

// Match `atom*`: zero or more, greedy with backtracking.
fn m_star(pat: str, apos: i64, qpos: i64, pend: i64, txt: str, tpos: i64, tlen: i64) -> MatchRes {
    let r1 = m_atom(pat, apos, txt, tpos, tlen);
    if (r1.ok == 1) {
        let r2 = m_star(pat, apos, qpos, pend, txt, r1.pos, tlen);
        if (r2.ok == 1) {
            return r2;
        }
        return m_seq(pat, qpos, pend, txt, tpos, tlen);
    }
    return m_seq(pat, qpos, pend, txt, tpos, tlen);
}

// Match `atom+`: one or more, greedy with backtracking.
fn m_plus(pat: str, apos: i64, qpos: i64, pend: i64, txt: str, tpos: i64, tlen: i64) -> MatchRes {
    let r1 = m_atom(pat, apos, txt, tpos, tlen);
    if (r1.ok == 0) {
        return MatchRes { ok: 0, pos: tpos };
    }
    return m_star(pat, apos, qpos, pend, txt, r1.pos, tlen);
}

// Match alternation `a|b|c` across [ppos, pend). Tries each branch in order.
fn m_alt(pat: str, ppos: i64, pend: i64, txt: str, tpos: i64, tlen: i64) -> MatchRes {
    let bar = find_top_bar(pat, ppos, pend);
    if (bar < 0) {
        return m_seq(pat, ppos, pend, txt, tpos, tlen);
    }
    let r1 = m_seq(pat, ppos, bar, txt, tpos, tlen);
    if (r1.ok == 1) {
        return r1;
    }
    return m_alt(pat, bar + 1, pend, txt, tpos, tlen);
}

// --- public API -------------------------------------------------------------

// Whole-string match: implicit `^...$` (a leading `^` is still honoured).
fn regex_full_match(pat: str, txt: str) -> bool {
    let s = String::from(pat);
    let tlen = len(txt);
    let mut pstart = 0;
    if (s.at(0) == 94) {
        pstart = 1;
    }
    let r = m_alt(pat, pstart, len(pat), txt, 0, tlen);
    if (r.ok == 1) {
        if (r.pos == tlen) {
            return true;
        }
    }
    return false;
}

// Search: does `txt` contain a match anywhere?
fn regex_match(pat: str, txt: str) -> bool {
    let s = String::from(pat);
    let tlen = len(txt);
    let mut pstart = 0;
    let mut anchored = 0;
    if (s.at(0) == 94) {
        pstart = 1;
        anchored = 1;
    }
    let mut t = 0;
    while (t <= tlen) {
        let r = m_alt(pat, pstart, len(pat), txt, t, tlen);
        if (r.ok == 1) {
            return true;
        }
        if (anchored == 1) {
            break;
        }
        t = t + 1;
    }
    return false;
}

// Quick smoke tests used by the CI / check step.
fn test_regex_basic() -> bool {
    if (regex_full_match("ab+c", "abbbc")) {
    } else {
        return false;
    }
    if (regex_full_match("ab+c", "ac")) {
        return false;
    }
    if (regex_match("\\d+", "abc123def")) {
    } else {
        return false;
    }
    if (regex_full_match("[a-z]+[0-9]*", "hello42")) {
    } else {
        return false;
    }
    if (regex_full_match("^a.c$", "axc")) {
    } else {
        return false;
    }
    if (regex_full_match("(ab|cd)e", "cde")) {
    } else {
        return false;
    }
    if (regex_full_match("colou?r", "color")) {
    } else {
        return false;
    }
    if (regex_full_match("a.*z", "abbbz")) {
    } else {
        return false;
    }
    return true;
}
