// aero-lru
// A simple LRU cache for pure-Aero programs (self-contained). Keys are
// strings, values are integers. Recency order is kept in two parallel vectors
// (newest at the end); eviction drops the front entry when full.
//
// Implementation note: Aero cannot assign a whole Vec field (c.keys = nk),
// so moves/removals are done with in-place set() shifts plus pop().

struct LruCache {
    keys: Vec<String>,
    vals: Vec<i64>,
    cap: i64,
}

// Copy a String into a fresh `str`.
fn lru_to_str(s: String) -> str {
    let n = s.len();
    let mut out = "";
    let mut i = 0;
    while (i < n) {
        out = out + format("%c", s.at(i));
        i = i + 1;
    }
    return out;
}

fn lru_new(cap: i64) -> LruCache {
    return LruCache { keys: Vec::new(), vals: Vec::new(), cap: cap };
}

fn lru_len(c: &LruCache) -> i64 {
    return c.keys.len();
}

fn lru_cap(c: &LruCache) -> i64 {
    return c.cap;
}

struct LruRes {
    hit: i64,
    val: i64,
}

// Look up a key; on a hit the entry moves to the most-recent position.
fn lru_get(c: &mut LruCache, k: str) -> LruRes {
    let mut found = -1;
    let mut i = 0;
    while (i < c.keys.len()) {
        if (str_cmp(lru_to_str(c.keys.get(i)), k) == 0) {
            found = i;
        }
        i = i + 1;
    }
    if (found < 0) {
        return LruRes { hit: 0, val: 0 };
    }
    let val = c.vals.get(found);
    // move entry `found` to the end via left shifts
    let kk = c.keys.get(found);
    let mut j = found;
    while (j < c.keys.len() - 1) {
        c.keys.set(j, c.keys.get(j + 1));
        c.vals.set(j, c.vals.get(j + 1));
        j = j + 1;
    }
    c.keys.set(c.keys.len() - 1, kk);
    c.vals.set(c.vals.len() - 1, val);
    return LruRes { hit: 1, val: val };
}

fn lru_contains(c: &LruCache, k: str) -> bool {
    let mut i = 0;
    while (i < c.keys.len()) {
        if (str_cmp(lru_to_str(c.keys.get(i)), k) == 0) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Insert or update a key; evicts the least-recently-used key when full.
fn lru_put(c: &mut LruCache, k: str, v: i64) {
    let mut found = -1;
    let mut i = 0;
    while (i < c.keys.len()) {
        if (str_cmp(lru_to_str(c.keys.get(i)), k) == 0) {
            found = i;
        }
        i = i + 1;
    }
    if (found >= 0) {
        // update the value, then move the entry to the end
        let mut j = found;
        let kk = c.keys.get(found);
        while (j < c.keys.len() - 1) {
            c.keys.set(j, c.keys.get(j + 1));
            c.vals.set(j, c.vals.get(j + 1));
            j = j + 1;
        }
        c.keys.set(c.keys.len() - 1, kk);
        c.vals.set(c.vals.len() - 1, v);
        return;
    }
    if (c.keys.len() >= c.cap) {
        // evict the front (oldest) by shifting everyone left
        let mut j = 0;
        while (j < c.keys.len() - 1) {
            c.keys.set(j, c.keys.get(j + 1));
            c.vals.set(j, c.vals.get(j + 1));
            j = j + 1;
        }
        c.keys.set(c.keys.len() - 1, String::from(k));
        c.vals.set(c.vals.len() - 1, v);
        return;
    }
    c.keys.push(String::from(k));
    c.vals.push(v);
}

// Remove a key; returns 1 when it was present.
fn lru_remove(c: &mut LruCache, k: str) -> i64 {
    let mut found = -1;
    let mut i = 0;
    while (i < c.keys.len()) {
        if (str_cmp(lru_to_str(c.keys.get(i)), k) == 0) {
            found = i;
        }
        i = i + 1;
    }
    if (found < 0) {
        return 0;
    }
    let mut j = found;
    while (j < c.keys.len() - 1) {
        c.keys.set(j, c.keys.get(j + 1));
        c.vals.set(j, c.vals.get(j + 1));
        j = j + 1;
    }
    c.keys.pop();
    c.vals.pop();
    return 1;
}

fn test_lru_basic() -> bool {
    let mut c = lru_new(2);
    lru_put(&mut c, "a", 1);
    lru_put(&mut c, "b", 2);
    if (lru_len(&c) != 2) {
        return false;
    }
    // touch "a" so "b" becomes the eviction candidate
    let r = lru_get(&mut c, "a");
    if (r.hit != 1) {
        return false;
    }
    if (r.val != 1) {
        return false;
    }
    lru_put(&mut c, "c", 3);
    if (lru_len(&c) != 2) {
        return false;
    }
    if (lru_contains(&c, "b")) {
        return false;
    }
    if (lru_contains(&c, "c")) {
    } else {
        return false;
    }
    if (lru_contains(&c, "a")) {
    } else {
        return false;
    }
    // update an existing key
    lru_put(&mut c, "c", 30);
    let r2 = lru_get(&mut c, "c");
    if (r2.val != 30) {
        return false;
    }
    // remove
    if (lru_remove(&mut c, "a") != 1) {
        return false;
    }
    if (lru_len(&c) != 1) {
        return false;
    }
    return true;
}
