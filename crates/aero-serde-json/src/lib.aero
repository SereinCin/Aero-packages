// aero-serde-json
// JSON-focused serialization helpers for pure-Aero programs (self-contained).
// Covers encoding scalars/strings/objects and decoding flat `"key": value`
// pairs, plus string-literal escaping/unescaping.

// Trim ASCII whitespace.
fn sj_trim(s: str) -> str {
    let src = String::from(s);
    let n = src.len();
    let mut b = 0;
    while ((b < n) && (src.at(b) <= 32)) {
        b = b + 1;
    }
    let mut e = n;
    while ((e > b) && (src.at(e - 1) <= 32)) {
        e = e - 1;
    }
    if (b >= e) {
        return "";
    }
    return substr(s, b, e);
}

// Encode a string as a JSON string literal (with escapes).
fn serde_json_encode_str(s: str) -> str {
    let src = String::from(s);
    let n = src.len();
    let mut out = "\"";
    let mut i = 0;
    while (i < n) {
        let c = src.at(i);
        if (c == 34) {
            out = out + "\\\"";
        } else if (c == 92) {
            out = out + "\\\\";
        } else if (c == 10) {
            out = out + "\\n";
        } else if (c == 13) {
            out = out + "\\r";
        } else if (c == 9) {
            out = out + "\\t";
        } else {
            out = out + format("%c", c);
        }
        i = i + 1;
    }
    out = out + "\"";
    return out;
}

fn serde_json_encode_int(v: i64) -> str {
    return format("%lld", v);
}

fn serde_json_encode_bool(b: bool) -> str {
    if (b) {
        return "true";
    }
    return "false";
}

// Decode one escape sequence (char after '\') inside a JSON string.
fn sj_esc(s: str, at: i64) -> str {
    let c = String::from(s).at(at);
    if (c == 110) {
        return format("%c", 10);
    }
    if (c == 116) {
        return format("%c", 9);
    }
    if (c == 114) {
        return format("%c", 13);
    }
    if (c == 98) {
        return format("%c", 8);
    }
    if (c == 102) {
        return format("%c", 12);
    }
    if (c == 47) {
        return "/";
    }
    return format("%c", c);
}

// Decode a JSON string literal (starting at an opening quote) to a raw string.
fn serde_json_decode(s: str) -> str {
    let src = String::from(s);
    let n = src.len();
    let mut i = 0;
    while ((i < n) && (src.at(i) <= 32)) {
        i = i + 1;
    }
    if ((i >= n) || (src.at(i) != 34)) {
        return s;
    }
    let mut pos = i + 1;
    let mut out = "";
    while (pos < n) {
        let c = src.at(pos);
        if (c == 34) {
            return out;
        }
        if (c == 92) {
            out = out + sj_esc(s, pos + 1);
            pos = pos + 2;
        } else {
            out = out + format("%c", c);
            pos = pos + 1;
        }
    }
    return out;
}

// Find the first `"key":` at the top level of an object and return the value
// (as raw text; strings are unquoted).
fn serde_json_get(obj: str, key: str) -> str {
    let src = String::from(obj);
    let n = src.len();
    let mut pos = 0;
    while (pos < n) {
        pos = sj_skip(obj, pos);
        if (pos >= n) {
            break;
        }
        if (src.at(pos) == 125) {
            break;
        }
        if (src.at(pos) != 34) {
            // not a key; advance past this token
            let c = src.at(pos);
            if (c == 123 || c == 91) {
                pos = pos + 1;
            } else {
                pos = pos + 1;
            }
            continue;
        }
        // read the key string
        let kend = pos + 1;
        let mut kpos = kend;
        while (kpos < n) {
            let kc = src.at(kpos);
            if (kc == 34) {
                break;
            }
            if (kc == 92) {
                kpos = kpos + 2;
            } else {
                kpos = kpos + 1;
            }
        }
        let key_text = substr(obj, pos + 1, kpos);
        pos = sj_skip(obj, kpos + 1);
        if ((pos < n) && (src.at(pos) == 58)) {
            pos = sj_skip(obj, pos + 1);
        }
        // value
        if (pos < n) {
            let vc = src.at(pos);
            if (vc == 34) {
                let vs = pos + 1;
                let mut ve = vs;
                while (ve < n) {
                    let vv = src.at(ve);
                    if (vv == 34) {
                        break;
                    }
                    if (vv == 92) {
                        ve = ve + 2;
                    } else {
                        ve = ve + 1;
                    }
                }
                let val = substr(obj, vs, ve);
                if (str_cmp(key_text, key) == 0) {
                    return serde_json_decode(val);
                }
                pos = ve + 1;
            } else if (vc == 123 || vc == 91) {
                let mut d = 1;
                let mut e2 = pos + 1;
                while ((e2 < n) && (d > 0)) {
                    let ch = src.at(e2);
                    if (ch == 123 || ch == 91) {
                        d = d + 1;
                    } else if (ch == 125 || ch == 93) {
                        d = d - 1;
                    }
                    e2 = e2 + 1;
                }
                let val = substr(obj, pos, e2);
                if (str_cmp(key_text, key) == 0) {
                    return val;
                }
                pos = e2;
            } else {
                let vs = pos;
                let mut ve = pos;
                while ((ve < n) && (src.at(ve) != 44) && (src.at(ve) != 125) && (src.at(ve) != 93) && (src.at(ve) > 32)) {
                    ve = ve + 1;
                }
                let val = substr(obj, vs, ve);
                if (str_cmp(key_text, key) == 0) {
                    return val;
                }
                pos = ve;
            }
        }
        if ((pos < n) && (src.at(pos) == 44)) {
            pos = pos + 1;
        }
    }
    return "";
}

fn sj_skip(s: str, pos: i64) -> i64 {
    let src = String::from(s);
    let n = src.len();
    let mut p = pos;
    while ((p < n) && (src.at(p) <= 32)) {
        p = p + 1;
    }
    return p;
}

fn serde_json_get_int(obj: str, key: str) -> i64 {
    return str_to_int(serde_json_get(obj, key));
}

fn serde_json_get_bool(obj: str, key: str) -> bool {
    return str_cmp(serde_json_get(obj, key), "true") == 0;
}

// Copy a String into a fresh `str`.
fn sjs_to_str(s: String) -> str {
    let n = s.len();
    let mut out = "";
    let mut i = 0;
    while (i < n) {
        out = out + format("%c", s.at(i));
        i = i + 1;
    }
    return out;
}

// Build a flat object from parallel key/value arrays.
fn serde_json_object(keys: Vec<String>, vals: Vec<String>) -> str {
    let mut out = "{";
    let mut i = 0;
    while (i < keys.len()) {
        if (i > 0) {
            out = out + ",";
        }
        out = out + serde_json_encode_str(sjs_to_str(keys.get(i))) + ":" + sjs_to_str(vals.get(i));
        i = i + 1;
    }
    out = out + "}";
    return out;
}

fn test_serde_json_basic() -> bool {
    if (str_cmp(serde_json_encode_str("a\"b"), "\"a\\\"b\"") != 0) {
        return false;
    }
    if (str_cmp(serde_json_decode("\"hi\\n\""), "hi\n") != 0) {
        return false;
    }
    if (str_cmp(serde_json_get("{\"name\":\"aero\",\"age\":30}", "name"), "aero") != 0) {
        return false;
    }
    if (serde_json_get_int("{\"age\":30}", "age") != 30) {
        return false;
    }
    if (serde_json_get_bool("{\"on\":true}", "on")) {
    } else {
        return false;
    }
    if (str_cmp(serde_json_encode_int(42), "42") != 0) {
        return false;
    }
    return true;
}
