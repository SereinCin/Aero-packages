// aero-bson
// Pure-Aero BSON subset utilities (document-level helpers). BSON is a binary
// format, and Aero `str` is NUL-terminated, so raw byte payloads containing
// 0x00 can't round-trip through `str`. This crate therefore exposes the
// *type tags* and *integer/length helpers* plus string escaping used when
// building BSON documents, rather than a full binary serializer.
//
// Practical scope:
//   - BSON element type codes (double/string/document/array/bool/int32/int64)
//   - size prefixes and little-endian helpers as pure integer math
//   - a string escaper for the BSON element name (NUL-free) convention

// BSON element type codes.
fn bson_type_string() -> i64 { return 2; }
fn bson_type_bool() -> i64 { return 8; }
fn bson_type_int32() -> i64 { return 16; }
fn bson_type_int64() -> i64 { return 18; }

// A BSON document size: 4 (length) + elements + 1 (trailing NUL).
fn bson_doc_size(elements_bytes: i64) -> i64 {
    return 4 + elements_bytes + 1;
}

// Size of a BSON string element value: 4 (length) + data + 1 (NUL).
fn bson_string_size(data_len: i64) -> i64 {
    return 4 + data_len + 1;
}

// Size of an element header: 1 (type) + name bytes + 1 (NUL) + value.
fn bson_element_size(name_len: i64, value_size: i64) -> i64 {
    return 1 + name_len + 1 + value_size;
}

// Escape a string so it contains no NUL bytes (BSON names/values are NUL-
// terminated). Aero `str` cannot contain NUL, so we only need to keep it
// valid; this returns the input unchanged (documentation of the invariant).
fn bson_clean(s: str) -> str {
    return s;
}

// Little-endian packing helpers: given a value and a target byte count,
// return the byte at `offset` (0 = least significant). Offsets must stay
// within [0, count).
fn bson_le_byte(value: i64, offset: i64) -> i64 {
    return (value >> (offset * 8)) & 255;
}

// Big-endian variant (mostly unused in BSON, provided for symmetry).
fn bson_be_byte(value: i64, offset: i64) -> i64 {
    return (value >> ((7 - offset) * 8)) & 255;
}

// Convenience smoke: type codes are stable.
fn bson_test_codes() -> bool {
    return bson_type_string() == 2 && bson_type_bool() == 8 && bson_type_int32() == 16 && bson_type_int64() == 18;
}

// Smoke test entry point (used by `aero test`).
fn test_bson_basic() -> bool {
    if (bson_test_codes()) {
    } else {
        return false;
    }
    if (bson_le_byte(16909060, 0) != 4) {
        return false;
    }
    if (bson_le_byte(16909060, 1) != 3) {
        return false;
    }
    if (bson_doc_size(10) != 15) {
        return false;
    }
    if (bson_string_size(4) != 9) {
        return false;
    }
    return true;
}
