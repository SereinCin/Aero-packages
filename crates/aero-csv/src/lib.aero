// aero-csv
// Pure-Aero CSV reader/writer for the standard subset: comma-separated fields,
// optional surrounding double quotes, and doubled quotes ("") as an escape.
//
// Aero has no way to annotate a local `Vec<String>`, so parsing returns the
// fields joined by the ASCII Unit Separator (0x1F); `csv_field` extracts the
// i-th field and `csv_field_count` counts them. Quoted fields may contain
// commas; newlines inside quotes are not handled (one line at a time).

// Split one CSV line into fields, joined by 0x1F.
fn csv_parse_line(line: str) -> str {
    let s = String::from(line);
    let n = s.len();
    let out = "";
    let in_quotes = 0;
    let i = 0;
    while (i < n) {
        let c = s.at(i);
        if (in_quotes == 1) {
            if (c == 34) {
                // "" inside quotes -> literal quote; closing quote otherwise
                if (i + 1 < n && s.at(i + 1) == 34) {
                    out = out + format("%c", 34);
                    i = i + 2;
                } else {
                    in_quotes = 0;
                    i = i + 1;
                }
            } else {
                out = out + format("%c", c);
                i = i + 1;
            }
        } else {
            if (c == 34) {
                in_quotes = 1;
                i = i + 1;
            } else if (c == 44) {
                out = out + format("%c", 31);   // field separator
                i = i + 1;
            } else if (c == 13) {
                i = i + 1;                      // ignore CR from CRLF
            } else {
                out = out + format("%c", c);
                i = i + 1;
            }
        }
    }
    return out;
}

// Number of fields in a parsed CSV line (0x1F count + 1).
fn csv_field_count(line: str) -> i64 {
    let s = String::from(line);
    let n = s.len();
    let count = 1;
    let i = 0;
    while (i < n) {
        if (s.at(i) == 31) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// Extract the i-th field from a parsed line ("" when out of range).
fn csv_field(line: str, index: i64) -> str {
    let s = String::from(line);
    let n = s.len();
    let start = 0;
    let cur = 0;
    let i = 0;
    while (i <= n) {
        if ((i == n) || (s.at(i) == 31)) {
            if (cur == index) {
                return substr(line, start, i);
            }
            cur = cur + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

// Quote a field for output when it contains a comma, quote, CR or LF.
fn csv_quote_field(s: str) -> str {
    let src = String::from(s);
    let n = src.len();
    let need = 0;
    let i = 0;
    while (i < n) {
        let c = src.at(i);
        if (c == 44 || c == 34 || c == 10 || c == 13) {
            need = 1;
        }
        i = i + 1;
    }
    if (need == 0) {
        return s;
    }
    let out = "\"";
    let j = 0;
    while (j < n) {
        let c = src.at(j);
        if (c == 34) {
            out = out + "\"\"";
        } else {
            out = out + format("%c", c);
        }
        j = j + 1;
    }
    out = out + "\"";
    return out;
}

// Render a parsed field list (joined by 0x1F) back into a CSV line.
fn csv_render(fields: str) -> str {
    let s = String::from(fields);
    let n = s.len();
    let out = "";
    let start = 0;
    let i = 0;
    while (i <= n) {
        if ((i == n) || (s.at(i) == 31)) {
            if (len(out) > 0) {
                out = out + ",";
            }
            out = out + csv_quote_field(substr(fields, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// Smoke test entry point (used by `aero test`).
fn test_csv_basic() -> bool {
    if (csv_field_count("a,b,c") != 3) {
        return false;
    }
    if (str_cmp(csv_field("a,b,c", 1), "b") != 0) {
        return false;
    }
    if (str_cmp(csv_field("x,\"y,z\",w", 1), "y,z") != 0) {
        return false;
    }
    if (str_cmp(csv_quote_field("a,b"), "\"a,b\"") != 0) {
        return false;
    }
    return true;
}
